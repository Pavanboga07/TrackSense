# Server port
PORT=5000

# JWT — change this to a long random secret before deploying
JWT_SECRET=change_this_to_a_long_random_secret_minimum_32_chars
JWT_EXPIRES_IN=7d

# SQLite database file path (relative to /backend)
DB_PATH=./analytics.db

# CORS — comma-separated list of allowed origins, or * to allow all
# Example: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=*

# Admin account setup — only users who supply this key during registration get the admin role
# Set to a strong random secret. Leave blank to disable admin self-registration.
ADMIN_SETUP_KEY=change_this_to_a_strong_admin_secret
