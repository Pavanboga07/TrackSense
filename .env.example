# ════════════════════════════════════════════════════════════════════════════════
# PROJECT SETUP — Copy this file to .env and fill in the values
# ════════════════════════════════════════════════════════════════════════════════

# ──── SERVER CONFIGURATION ────────────────────────────────────────────────────
# Port to run the backend server on
PORT=5000

# Allowed origins for CORS (comma-separated). Use * for development, specific domains for production
ALLOWED_ORIGINS=*

# ──── DATABASE ────────────────────────────────────────────────────────────────
# Path to SQLite database file. Leave as-is for local development
DB_PATH=./analytics.db

# ──── JWT AUTHENTICATION ──────────────────────────────────────────────────────
# Secret key for signing JWT tokens. CHANGE THIS to a secure random string!
# Generate with: openssl rand -base64 32 (or use any random 32+ character string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiration time (e.g., 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# ──── ADMIN SETUP ─────────────────────────────────────────────────────────────
# Secret key to enable /auth/setup endpoint (create first admin user). CHANGE THIS!
# Only used during initial setup. You can disable it later by removing this variable
ADMIN_SETUP_KEY=your-admin-setup-key-change-this

# ──── OLLAMA AI CONFIGURATION ─────────────────────────────────────────────────
# URL where Ollama server is running (default: http://localhost:11434)
# Change this if Ollama is running on a different machine
OLLAMA_URL=http://localhost:11434

# Model to use for AI insights. Common options:
#   - llama3.2         (8B model, balanced performance/quality)
#   - llama2           (7B model, lightweight)
#   - mistral          (7B model, instruction-following)
#   - neural-chat      (smaller model, conversational)
# Run 'ollama list' to see all available models
OLLAMA_MODEL=llama3.2

# ════════════════════════════════════════════════════════════════════════════════
# NOTES:
# 1. Create .env file by copying this: cp .env.example .env
# 2. Update JWT_SECRET and ADMIN_SETUP_KEY with secure values
# 3. Ensure Ollama is running before starting the backend
# ════════════════════════════════════════════════════════════════════════════════
